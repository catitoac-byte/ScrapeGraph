# Provedor de LLM: manual | deepseek | openai | anthropic | ollama
# "manual" = sem modelo conectado. A coleta funciona, os grafos nao.
LLM_PROVIDER=manual

# Opcional. Em branco usa o padrao do provedor.
LLM_MODEL=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Verificacao de caixa por servico externo (opcional).
# Necessario porque confirmar existencia de caixa exige IP com boa
# reputacao, o que esta maquina nao tem.
# Opcoes: zerobounce | neverbounce | bouncer
VALIDADOR=
VALIDADOR_API_KEY=
